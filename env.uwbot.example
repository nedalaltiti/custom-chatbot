# This file should be copied to .env.uwbot for the UWBot instance

# Application Configuration
ENVIRONMENT=production
DEBUG=false
APP_NAME=UWBot Teams Bot
HOST=0.0.0.0
PORT=3980

# AWS Configuration
USE_AWS_SECRETS=true
AWS_REGION=us-west-1
AWS_ACCESS_KEY_ID=${UWBOT_AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${UWBOT_AWS_SECRET_ACCESS_KEY}

# AWS Secret Names - UWBot specific
AWS_DB_SECRET_NAME=chatbot-clarity-db-dev-postgres

# Microsoft Teams Credentials - UWBot tenant
MICROSOFT_APP_ID=${UWBOT_MICROSOFT_APP_ID}
MICROSOFT_APP_PASSWORD=${UWBOT_MICROSOFT_APP_PASSWORD}
TENANT_ID=${UWBOT_TENANT_ID}
CLIENT_ID=${UWBOT_CLIENT_ID}
CLIENT_SECRET=${UWBOT_CLIENT_SECRET}

# External Validation API Configuration
EXTERNAL_VALIDATION_API_URL=https://api.validation.example.com
EXTERNAL_VALIDATION_TIMEOUT=30.0

# UWBot-specific settings
FEEDBACK_TIMEOUT_MINUTES=10
SESSION_IDLE_MINUTES=30

# Database Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Performance Settings
CACHE_TTL_SECONDS=3600

# Hardship Validation Fields
HARDSHIP_BENEFICIARY_ID=beneficiary_id
HARDSHIP_CONTACT_ID=contact_id
HARDSHIP_AMOUNT=amount
HARDSHIP_APPROVAL_STATUS=approval_status
HARDSHIP_REASON=reason

# Budget Validation Fields
BUDGET_C_TYPE=c_type
BUDGET_ISCOAPP=iscoapp
BUDGET_LEADSTATUS=leadstatus

# Feature Flags
USE_INTENT_CLASSIFICATION=false
ENABLE_BACKGROUND_TASKS=true
